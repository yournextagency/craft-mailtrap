{
  "name": "yournextagency/craft-mailtrap",
  "description": "Mailtrap integration for Craft CMS",
  "type": "craft-plugin",
  "keywords": ["cms", "craftcms", "mailtrap", "mailer", "yii2"],
  "license": "MIT",
  "authors": [
    {
      "name": "Your Next Agency",
      "homepage": "https://yournextagency.com"
    }
  ],
  "support": {
    "email": "developers@yournextagency.com",
    "issues": "https://github.com/yournextagency/craft-mailtrap/issues?state=open",
    "source": "https://github.com/yournextagency/craft-mailtrap",
    "docs": "https://github.com/yournextagency/craft-mailtrap/blob/master/README.md"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.0.2",
    "craftcms/cms": "^4.0.0|^5.0.0",
    "symfony/mailer": "^6.0|^7.0",
    "symfony/http-client": "^6.0.3|^7.0"
  },
  "require-dev": {
    "craftcms/phpstan": "dev-main",
    "craftcms/rector": "dev-main",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^9.6|^11.0"
  },
  "autoload": {
    "psr-4": {
      "yna\\mailtrap\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "yna\\mailtrap\\tests\\": "tests/"
    }
  },
  "extra": {
    "name": "Mailtrap",
    "handle": "mailtrap",
    "documentationUrl": "https://github.com/yournextagency/craft-mailtrap/blob/master/README.md"
  },
  "scripts": {
    "phpstan": "phpstan --memory-limit=1G",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    }
  }
}
